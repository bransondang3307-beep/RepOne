{
  "name": "repone",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test:scripts && npm run test --workspaces --if-present",
    "test:scripts": "node --test scripts/check-boundaries.test.mjs scripts/check-workflow-policy.test.mjs scripts/experiments/batches.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:workflows": "node scripts/check-workflow-policy.mjs",
    "verify": "npm run check:boundaries && npm run check:workflows && npm run typecheck && npm test"
  },
  "devDependencies": {
    "yaml": "2.9.1"
  }
}
