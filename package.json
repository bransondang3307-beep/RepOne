{
  "name": "repone",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test:scripts && npm run test --workspaces --if-present",
    "test:scripts": "node --test scripts/check-boundaries.test.mjs scripts/check-workflow-policy.test.mjs scripts/dev-host/controller.test.mjs scripts/dev-host/safety.test.mjs",
    "dev-host:report": "node scripts/dev-host/dev-host.mjs report",
    "test:firmware": "node firmware/test/host/run.mjs && node --experimental-transform-types --disable-warning=ExperimentalWarning --test firmware/tools/decode-serial-capture.test.mjs firmware/tools/firmware-to-decoder.test.mjs",
    "decode:serial": "node --experimental-transform-types --disable-warning=ExperimentalWarning firmware/tools/decode-serial-capture.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:workflows": "node scripts/check-workflow-policy.mjs",
    "verify": "npm run check:boundaries && npm run check:workflows && npm run typecheck && npm test"
  },
  "devDependencies": {
    "yaml": "2.9.1"
  },
  "overrides": {
    "react": "19.3.0"
  }
}
